# Copy this file to .env.secrets.local (git-ignored via .env.*.local) and fill in real values.
# NEVER commit .env.secrets.local to Git.

AWS_REGION=ap-southeast-1

# Neon Serverless PostgreSQL (pooled for app Pods, direct for migration Job)
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_DATABASE_DIRECT_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ElastiCache Redis 7 TLS URL (leave empty to auto-read `terraform output -raw redis_url`)
REDIS_URL=rediss://kubeticket-dev-redis.xxxxxx.ng.0001.apse1.cache.amazonaws.com:6379/0

# Auth & QR HMAC signing secrets (leave empty to auto-generate strong 64-char hex strings)
JWT_SECRET=
TICKET_QR_HMAC_SECRET=

# Optional Cloudflare Turnstile & Stripe sandbox/live credentials
TURNSTILE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
