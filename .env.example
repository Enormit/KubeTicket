# =============================================================================
# KubeTicket - Environment Configuration Example
# Copy this file to .env and fill in real values (NEVER commit .env)
# =============================================================================

# --- Application ---
APP_NAME=kubeticket
APP_ENV=development
LOG_LEVEL=info
PORT=8080

# --- Database (Neon Serverless PostgreSQL - ACID) ---
NEON_DATABASE_POOLED_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
NEON_DATABASE_DIRECT_URL=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Local Docker Compose fallback for offline development & integration tests
LOCAL_DATABASE_URL=postgresql://kubeticket:kubeticket@localhost:5432/kubeticket?sslmode=disable

# --- Redis (Seat Lock, Waiting Room & WebSocket Pub/Sub) ---
REDIS_URL=redis://localhost:6379/0
REDIS_MODE=standalone
SEAT_HOLD_TTL_SECONDS=300
CHECKOUT_HOLD_TTL_SECONDS=900
QUEUE_ADMISSION_RATE=50

# --- Auth & Security ---
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=24h
TICKET_QR_HMAC_SECRET=change-me-to-hmac-secret
TURNSTILE_SECRET_KEY=

# --- AWS / Messaging (Optional for Local, Required for EKS/Prod) ---
AWS_REGION=ap-southeast-1
SQS_ORDER_QUEUE_URL=
AWS_ECR_REGISTRY=

# --- Payment Gateway (Sandbox) ---
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# --- Observability (Prometheus / Grafana / Alertmanager) ---
PROMETHEUS_METRICS_PATH=/metrics
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
